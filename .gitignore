runs/
runs_continuous/
*.tfevents.*

# Scratch Scripts & Intermediate Output
scratch/
plots/
*.log
MUJOCO_LOG.TXT

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
